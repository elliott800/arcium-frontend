# Not needed with `npm run sim` (the simulated backend sets everything itself). For `npm run dev` on your own
# Postgres: copy to .env.local (never committed) and fill the first block (npm run demo:create, npm run dev,
# npm run demo:seed). Real production values live in the
# owner's private arcium production site repo, never here. The full list of names the site may read is the
# hooks contract (contract/hooks.json).

# ── development: a local demo database ──
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/arcium_demo
ARCIUM_SITE_MODE=demo
ARCIUM_SECRET_KEY=change-me-to-any-32-or-more-random-characters

# ── optional ──
# SITE_URL=http://localhost:3000            the address links and previews use
# APP_ORIGIN=http://localhost:3000          where hubs send people back after sign-in
# DATAHUB_ORIGIN=http://localhost:8091      a local Data Hub, for the datahub host routing
# DEMO_SITE_URL=                            the demo's address, shown as "Try the demo" on the live site
# ARCIUM_SIGNUP_OPEN=false                  account sign-up (off: the live site is the owner's)

# ── production only (the owner's): sign-in by other Arcium sites, mail, keys ──
# SSO_SECRET_DATAHUB= / SSO_SECRET_FUSIONHUB=   shared secrets for the hubs' single sign-on
# RESEND_API_KEY= / MAIL_FROM= / SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASS=   password-reset mail
# ARCIUM_ADMIN_EMAIL= / ARCIUM_ADMIN_PASSWORD=  the owner account created on a fresh database
# SCANNER_PICKS_KEY=                         the scanner's push key

# Optional: the owner's private content folder (Fusion pages, the real schedule and its PDF; src/lib/private-content.ts).
# Leave unset to use the public stand-ins in this repository.
# ARCIUM_PRIVATE_DIR=

# Optional: where npm run sim keeps its simulated database (default .sim-db/). Set it outside the repo when the
# repo is in a synced folder (Google Drive, OneDrive, Dropbox), whose clients lock files while uploading.
# ARCIUM_SIM_DIR=
